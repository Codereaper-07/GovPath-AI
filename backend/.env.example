# ---- App ----
APP_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---- Database (Supabase PostgreSQL + pgvector) ----
# Supabase dashboard -> Connect -> Session pooler (IPv4-compatible) or Direct connection.
# A plain postgresql:// URL is fine; the app converts it to the psycopg driver automatically.
# Example shape (do not commit real values):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Supabase requires TLS
DB_SSLMODE=require
DB_ECHO=false
# Seconds the API caches read-only knowledge (services, documents, planning snapshot); 0 disables.
# After re-seeding, changes appear within this window (or restart the API).
KNOWLEDGE_CACHE_SECONDS=60

# ---- Supabase Auth ----
# Project URL (Supabase dashboard -> Project Settings -> API), e.g. https://<project-ref>.supabase.co
# Access tokens are verified with the project's public JWKS; no secret or service-role key needed.
SUPABASE_URL=

# Shared secret for the external expiry scheduler (POST /api/internal/expire-documents with
# header X-Cron-Secret). Leave empty to disable the endpoint (use `python -m scripts.expire_documents`).
CRON_SECRET=

# ---- Google Gemini API ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match the pgvector column dimension. Changing it requires a migration + re-embedding.
EMBEDDING_DIM=768
# Free-tier protection (all optional; defaults shown)
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_RETRIES=3
GEMINI_MIN_INTERVAL_SECONDS=1.0
GEMINI_DAILY_GENERATION_LIMIT=200
GEMINI_DAILY_EMBEDDING_LIMIT=500
ASSISTANT_CACHE_SECONDS=86400
# Retrieval
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.66
