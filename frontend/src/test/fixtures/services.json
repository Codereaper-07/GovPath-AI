  {
    "id": "vehicle-rc-address-change",
    "name": "Vehicle RC address change",
    "name_hi": "\u0935\u093e\u0939\u0928 \u0906\u0930\u0938\u0940 \u092e\u0947\u0902 \u092a\u0924\u093e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928",
