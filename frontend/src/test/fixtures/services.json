    "name_hi": "\u092a\u0924\u093e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0939\u0947\u0924\u0941 \u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f \u092a\u0941\u0928\u0903 \u091c\u093e\u0930\u0940 \u0915\u0930\u0928\u093e",
