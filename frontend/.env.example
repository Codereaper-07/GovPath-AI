# Base URL of the GovPath AI FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth (email sign-in). Public values only: the project URL and the PUBLISHABLE
# (or legacy anon) key from Supabase dashboard -> Project Settings -> API Keys.
# NEVER put the service-role / secret key here (everything VITE_* ships to the browser).
# Leave empty to run without accounts (all public pages keep working).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

